generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

enum PermissionLevel {
  READ
  WRITE
  ADMIN
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

enum SlugType {
  USER
  TAG
}

enum NotificationType {
  PAGE_EDITED
  FRIEND_REQUEST
}

enum PageReactionType {
  FAVORITE
  DISLIKE
}

// ════════════════════════════════════════════
// USERS
// ════════════════════════════════════════════

model User {
  user_id                 String               @id @default(uuid())
  accountId               String               @unique @map("account_id")
  username                String
  firstName               String?              @map("first_name")
  lastName                String?              @map("last_name")
  imgLink                 String               @default("/defaultUserProfilePicture.svg") @map("img_link")
  email                   String               @unique
  password                String
  createdAt               DateTime             @default(now()) @map("created_at")
  lastSeen                DateTime             @default(now()) @map("last_seen")
  emailVerified           Boolean              @default(false) @map("email_verified")
  verifCode               String?              @map("verif_code")
  verifExpiry             DateTime?            @map("verif_expiry")
  twoFactorEnabled        Boolean              @default(false) @map("two_factor_enabled")
  receivedFriendships     Friendship[]         @relation("ReceivedFriendships")
  sentFriendships         Friendship[]         @relation("SentFriendships")
  uploads                 Upload[]             @relation("FileOwner")
  notificationsCaused     Notification[]       @relation("NotificationActor")
  notifications           Notification[]       @relation("NotificationRecipient")
  orgMemberships          OrganizationMember[]
  ownedOrganizations      Organization[]       @relation("OrganizationOwner")
  pagePermissions         PagePermission[]
  pageReactions           PageReaction[]
  editedPages             Page[]               @relation("PageLastEditor")
  ownedPages              Page[]               @relation("PageOwner")
  sessions                Session[]            @relation("UserSession")
  tagMemberships          TagMember[]
  tagPageRequestsMade     TagPageRequest[]     @relation("RequestedBy")
  tagPageRequestsReviewed TagPageRequest[]     @relation("ReviewedBy")
  tagPermissions          TagPermission[]
  ownedTags               Tag[]                @relation("TagOwner")
  userInterests           UserTagInterest[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userToken String   @map("user_token")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  ipAddress String   @map("ip_address")
  user      User     @relation("UserSession", fields: [userToken], references: [user_id], onDelete: Cascade)

  @@map("sessions")
}

model Friendship {
  id          String           @id @default(uuid())
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  senderId    String
  sender      User             @relation("SentFriendships", fields: [senderId], references: [user_id], onDelete: Cascade)

  receiverId  String
  receiver    User             @relation("ReceivedFriendships", fields: [receiverId], references: [user_id], onDelete: Cascade)

  notifications Notification[]

  @@unique([senderId, receiverId])
}

model Upload {
  id         Int      @id @default(autoincrement())
  ownerToken String   @map("owner_token")
  url        String   @map("url")
  fileName   String
  fileSize   BigInt   @map("file_size")
  createdAt  DateTime @default(now())
  owner      User     @relation("FileOwner", fields: [ownerToken], references: [user_id])
}

model Tag {
  id                Int                 @id @default(autoincrement())
  ownerToken        String              @map("owner_token")
  name              String              @unique
  description       String?
  createdAt         DateTime            @default(now()) @map("created_at")
  namespace         String?             @unique
  color             Int?
  orgTagAccess      OrgTagAccess[]
  orgTagCapability  OrgTagCapability[]
  members           TagMember[]
  tagPageAccess     TagPageAccess[]
  tagPageCapability TagPageCapability[]
  tagPageRequests   TagPageRequest[]
  tagPages          TagPage[]
  permissions       TagPermission[]
  roles             TagRole[]
  statistic         TagStatistic?
  owner             User                @relation("TagOwner", fields: [ownerToken], references: [user_id])
  userInterests     UserTagInterest[]

  @@map("tags")
}

model TagRole {
  id                         Int                 @id @default(autoincrement())
  tagId                      Int                 @map("tag_id")
  roleName                   String              @map("role_name")
  hierarchyLevel             Int                 @map("hierarchy_level")
  canManageMembers           Boolean             @default(false) @map("can_manage_members")
  canManageRoles             Boolean             @default(false) @map("can_manage_roles")
  canEditInfo                Boolean             @default(false) @map("can_edit_info")
  canDeleteTag               Boolean             @default(false) @map("can_delete_tag")
  canAddPage                 Boolean             @default(false) @map("can_add_page")
  canRevokePage              Boolean             @default(false) @map("can_revoke_page")
  canManagePageGrants        Boolean             @default(false) @map("can_manage_page_grants")
  canReviewRequests          Boolean             @default(false) @map("can_review_requests")
  members                    TagMember[]
  minRoleForPageAccess       TagPageAccess[]
  exactRoleForPageCapability TagPageCapability[]
  tag                        Tag                 @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([tagId, hierarchyLevel])
  @@map("tag_roles")
}

model TagMember {
  tagId     Int     @map("tag_id")
  userToken String  @map("user_token")
  roleId    Int     @map("role_id")
  role      TagRole @relation(fields: [roleId], references: [id])
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userToken], references: [user_id], onDelete: Cascade)

  @@id([tagId, userToken])
  @@map("tag_members")
}

model TagPermission {
  tagId               Int     @map("tag_id")
  userToken           String  @map("user_token")
  canManageMembers    Boolean @default(false) @map("can_manage_members")
  canManageRoles      Boolean @default(false) @map("can_manage_roles")
  canEditInfo         Boolean @default(false) @map("can_edit_info")
  canDeleteTag        Boolean @default(false) @map("can_delete_tag")
  canAddPage          Boolean @default(false) @map("can_add_page")
  canRevokePage       Boolean @default(false) @map("can_revoke_page")
  canManagePageGrants Boolean @default(false) @map("can_manage_page_grants")
  canReviewRequests   Boolean @default(false) @map("can_review_requests")
  tag                 Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)
  user                User    @relation(fields: [userToken], references: [user_id], onDelete: Cascade)

  @@id([tagId, userToken])
  @@map("tag_permissions")
}

model Page {
  pageId            Int                 @id @default(autoincrement()) @map("page_id")
  title             String
  content           Json?
  description       String?
  img               String?
  ownerId           String              @map("owner_id")
  createdAt         DateTime            @default(now()) @map("created_at")
  lastModified      DateTime            @updatedAt @map("last_modified")
  lastEditedById    String?             @map("last_edited_by_id")
  public            Boolean             @default(false)
  notifications     Notification[]
  orgPageAccess     OrgPageAccess[]
  orgPageCapability OrgPageCapability[]
  permissions       PagePermission[]
  pageReactions     PageReaction[]
  slugs             PageSlug[]
  lastEditor        User?               @relation("PageLastEditor", fields: [lastEditedById], references: [user_id])
  owner             User                @relation("PageOwner", fields: [ownerId], references: [user_id])
  tagPageAccess     TagPageAccess[]
  tagPageCapability TagPageCapability[]
  tagPageRequests   TagPageRequest[]
  tagPages          TagPage[]

  @@map("pages")
}

model PageSlug {
  id          Int      @id @default(autoincrement())
  pageId      Int      @map("page_id")
  namespace   String   @map("namespace")
  slug        String   @map("slug")
  type        SlugType @map("type")
  isCanonical Boolean  @default(false) @map("is_canonical")
  createdAt   DateTime @default(now()) @map("created_at")
  page        Page     @relation(fields: [pageId], references: [pageId], onDelete: Cascade)

  @@unique([namespace, slug])
  @@map("page_slugs")
}

model PagePermission {
  pageId               Int             @map("page_id")
  userToken            String          @map("user_token")
  permissions          PermissionLevel
  canManagePermissions Boolean         @default(false) @map("can_manage_permissions")
  canManageTags        Boolean         @default(false) @map("can_manage_tags")
  canRequestTags       Boolean         @default(false) @map("can_request_tags")
  page                 Page            @relation(fields: [pageId], references: [pageId], onDelete: Cascade)
  user                 User            @relation(fields: [userToken], references: [user_id], onDelete: Cascade)

  @@id([pageId, userToken])
  @@map("page_permissions")
}

model TagPage {
  tagId  Int  @map("tag_id")
  pageId Int  @map("page_id")
  page   Page @relation(fields: [pageId], references: [pageId], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([tagId, pageId])
  @@map("tag_pages")
}

model Notification {
  id           Int              @id @default(autoincrement())
  recipientId  String           @map("recipient_id")
  actorId      String?          @map("actor_id")
  pageId       Int?             @map("page_id")
  friendshipId String?          @map("friendship_id")
  type         NotificationType @default(PAGE_EDITED)
  read         Boolean          @default(false)
  createdAt    DateTime         @default(now()) @map("created_at")

  recipient  User        @relation("NotificationRecipient", fields: [recipientId], references: [user_id], onDelete: Cascade)
  actor      User?       @relation("NotificationActor", fields: [actorId], references: [user_id], onDelete: SetNull)
  page       Page?       @relation(fields: [pageId], references: [pageId], onDelete: Cascade)
  friendship Friendship? @relation(fields: [friendshipId], references: [id], onDelete: Cascade)

  @@index([recipientId, read])
  @@map("notifications")
}

model TagPageRequest {
  id          Int           @id @default(autoincrement())
  tagId       Int           @map("tag_id")
  pageId      Int           @map("page_id")
  requestedBy String        @map("requested_by")
  status      RequestStatus @default(PENDING)
  reviewedBy  String?       @map("reviewed_by")
  createdAt   DateTime      @default(now()) @map("created_at")
  page        Page          @relation(fields: [pageId], references: [pageId], onDelete: Cascade)
  requester   User          @relation("RequestedBy", fields: [requestedBy], references: [user_id])
  reviewer    User?         @relation("ReviewedBy", fields: [reviewedBy], references: [user_id])
  tag         Tag           @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@map("tag_page_requests")
}

model TagPageAccess {
  pageId      Int             @map("page_id")
  tagId       Int             @map("tag_id")
  minRoleId   Int             @map("min_role_id")
  permissions PermissionLevel
  minRole     TagRole         @relation(fields: [minRoleId], references: [id])
  page        Page            @relation(fields: [pageId], references: [pageId], onDelete: Cascade)
  tag         Tag             @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([pageId, tagId])
  @@map("tag_page_access")
}

model OrgPageAccess {
  orgId        Int              @map("org_id")
  pageId       Int              @map("page_id")
  minRoleId    Int              @map("min_role_id")
  permissions  PermissionLevel
  minRole      OrganizationRole @relation(fields: [minRoleId], references: [id])
  organization Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  page         Page             @relation(fields: [pageId], references: [pageId], onDelete: Cascade)

  @@id([orgId, pageId])
  @@map("org_page_access")
}

model TagPageCapability {
  pageId               Int     @map("page_id")
  tagId                Int     @map("tag_id")
  roleId               Int     @map("role_id")
  canManagePermissions Boolean @default(false) @map("can_manage_permissions")
  canManageTags        Boolean @default(false) @map("can_manage_tags")
  canRequestTags       Boolean @default(false) @map("can_request_tags")
  page                 Page    @relation(fields: [pageId], references: [pageId], onDelete: Cascade)
  role                 TagRole @relation(fields: [roleId], references: [id])
  tag                  Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([pageId, tagId, roleId])
  @@map("tag_page_capability")
}

model OrgPageCapability {
  orgId                Int              @map("org_id")
  pageId               Int              @map("page_id")
  roleId               Int              @map("role_id")
  canManagePermissions Boolean          @default(false) @map("can_manage_permissions")
  canManageTags        Boolean          @default(false) @map("can_manage_tags")
  canRequestTags       Boolean          @default(false) @map("can_request_tags")
  organization         Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  page                 Page             @relation(fields: [pageId], references: [pageId], onDelete: Cascade)
  role                 OrganizationRole @relation(fields: [roleId], references: [id])

  @@id([orgId, pageId, roleId])
  @@map("org_page_capability")
}

model Organization {
  id                Int                  @id @default(autoincrement())
  ownerToken        String               @map("owner_token")
  name              String               @unique
  createdAt         DateTime             @default(now()) @map("created_at")
  orgPageAccess     OrgPageAccess[]
  orgPageCapability OrgPageCapability[]
  orgTagAccess      OrgTagAccess[]
  orgTagCapability  OrgTagCapability[]
  members           OrganizationMember[]
  roles             OrganizationRole[]
  owner             User                 @relation("OrganizationOwner", fields: [ownerToken], references: [user_id])

  @@map("organizations")
}

model OrganizationRole {
  id                       Int                  @id @default(autoincrement())
  organizationId           Int                  @map("organization_id")
  roleName                 String               @map("role_name")
  hierarchyLevel           Int                  @map("hierarchy_level")
  canManageMembers         Boolean              @default(false) @map("can_manage_members")
  canManageRoles           Boolean              @default(false) @map("can_manage_roles")
  canEditInfo              Boolean              @default(false) @map("can_edit_info")
  canDeleteOrg             Boolean              @default(false) @map("can_delete_org")
  canManageOrgPageGrants   Boolean              @default(false) @map("can_manage_org_page_grants")
  canManageOrgTagGrants    Boolean              @default(false) @map("can_manage_org_tag_grants")
  minRoleForOrgPageAccess  OrgPageAccess[]
  roleForOrgPageCapability OrgPageCapability[]
  minRoleForOrgTagAccess   OrgTagAccess[]
  roleForOrgTagCapability  OrgTagCapability[]
  members                  OrganizationMember[]
  organization             Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, hierarchyLevel])
  @@map("organization_roles")
}

model OrganizationMember {
  organizationId Int              @map("organization_id")
  userToken      String           @map("user_token")
  roleId         Int              @map("role_id")
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           OrganizationRole @relation(fields: [roleId], references: [id])
  user           User             @relation(fields: [userToken], references: [user_id], onDelete: Cascade)

  @@id([organizationId, userToken])
  @@map("organization_members")
}

model OrgTagAccess {
  orgId        Int              @map("org_id")
  tagId        Int              @map("tag_id")
  minRoleId    Int              @map("min_role_id")
  permissions  PermissionLevel
  minRole      OrganizationRole @relation(fields: [minRoleId], references: [id])
  organization Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  tag          Tag              @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([orgId, tagId])
  @@map("org_tag_access")
}

model OrgTagCapability {
  orgId               Int              @map("org_id")
  tagId               Int              @map("tag_id")
  roleId              Int              @map("role_id")
  canManageTagMembers Boolean          @default(false) @map("can_manage_tag_members")
  canManageTagRoles   Boolean          @default(false) @map("can_manage_tag_roles")
  canAddPage          Boolean          @default(false) @map("can_add_page")
  canRevokePage       Boolean          @default(false) @map("can_revoke_page")
  canManagePageGrants Boolean          @default(false) @map("can_manage_page_grants")
  canReviewRequests   Boolean          @default(false) @map("can_review_requests")
  organization        Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  role                OrganizationRole @relation(fields: [roleId], references: [id])
  tag                 Tag              @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([orgId, tagId, roleId])
  @@map("org_tag_capability")
}

model UserTagInterest {
  userId String @map("user_id")
  tagId  Int    @map("tag_id")
  weight Float  @default(0)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [user_id], onDelete: Cascade)

  @@id([userId, tagId])
  @@index([userId])
  @@map("user_tag_interests")
}

model TagStatistic {
  tagId             Int   @id @map("tag_id")
  documentFrequency Int   @default(0) @map("document_frequency")
  idf               Float @default(1)
  tag               Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@map("tag_statistics")
}

model PageReaction {
  userId    String           @map("user_id")
  pageId    Int              @map("page_id")
  type      PageReactionType
  createdAt DateTime         @default(now()) @map("created_at")
  page      Page             @relation(fields: [pageId], references: [pageId], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [user_id], onDelete: Cascade)

  @@id([userId, pageId])
  @@index([userId, type])
  @@map("page_reactions")
}